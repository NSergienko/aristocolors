{
  "name": "@aristocolors/db",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL 16 + pgvector Database Schema and Drizzle ORM Client for AristoColors",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx test/db-schema.test.ts",
    "test:acceptance": "tsx test/phase0-acceptance.test.ts",
    "benchmark": "tsx test/hnsw-benchmark.test.ts",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aristocolors/contracts": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@aristocolors/config": "workspace:*",
    "@aristocolors/storage": "workspace:*",
    "drizzle-kit": "^0.31.9"
  }
}
